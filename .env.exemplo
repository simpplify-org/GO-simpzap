DOCKER_BRIDGE_HOST=

# Cria o primeiro usuário do /dash automaticamente no primeiro start
# (só é usado se ainda não existir nenhum usuário no banco de auth).
# Depois disso, novos usuários podem ser criados em /dash > "Gerenciar usuários".
ADMIN_USER=
ADMIN_PASSWORD=

# Se definida, /create, /devices, /delete e /device/* passam a exigir o
# header "X-API-Key: <valor abaixo>" em toda chamada. Deixe em branco para
# manter essas rotas abertas (comportamento atual). Antes de definir aqui,
# garanta que todos os serviços consumidores já estão enviando o header.
DEVICE_API_KEY=