DOCKER_BRIDGE_HOST=

# Cria o primeiro usuário do /dash automaticamente no primeiro start
# (só é usado se ainda não existir nenhum usuário no banco de auth).
# Depois disso, novos usuários podem ser criados em /dash > "Gerenciar usuários".
ADMIN_USER=
ADMIN_PASSWORD=
# Postgres onde os containers de device gravam o histórico de mensagens
# (tabela whatsapp_messages, criada automaticamente). O master repassa essa
# variável para cada container filho no momento em que ele é criado.
# Em branco = mensagens não são gravadas.
POSTGRES_DSN=
